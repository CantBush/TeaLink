TRANSPORT=local
# TRANSPORT=agntcy sends deliberation to agent processes over NATS (`make bus`, then `make agents`).
# If the broker or an agent is down, that call is answered in-process. The HTTP API does not change.
NATS_URL=nats://localhost:4222
LLM_MODEL=
# OPENAI_API_KEY=
# DATA_DIR=backend/data
